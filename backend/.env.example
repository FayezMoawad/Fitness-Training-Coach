# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (used starting Step 1 — DB Schema & Models)
DATABASE_URL=postgresql://user:password@localhost:5432/fitness_training_coach

# Secret used to sign JWTs (used starting Step 2 — Authentication). Generate a
# long random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me

# Access token lifetime, in minutes
JWT_EXPIRE_MINUTES=30
