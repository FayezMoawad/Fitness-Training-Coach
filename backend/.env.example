# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (used starting Step 1 — DB Schema & Models).
# Must use the `+psycopg` driver suffix — the installed driver is psycopg
# (v3, see requirements.txt), and plain `postgresql://` defaults to psycopg2,
# which isn't installed and will fail with "No module named 'psycopg2'".
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fitness_training_coach

# Secret used to sign JWTs (used starting Step 2 — Authentication). Generate a
# long random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me

# Access token lifetime, in minutes
JWT_EXPIRE_MINUTES=30
